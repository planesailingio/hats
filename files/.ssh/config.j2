# ~/.ssh/config — shared skeleton. Managed by hats.
#
# Three layers, read top to bottom. ssh takes the FIRST value it finds for each
# option, so each layer overrides everything below it:
#
#   1. ~/.ssh/config.d/<hat>.conf — the active hat's hosts and keys. `hat <name>`
#      exports $HATS_HAT and ssh expands it here, per process, so plain ssh, scp,
#      rsync and git all follow the shell's hat with no wrappers. A hat with no
#      file is fine: it just gets the layers below.
#   2. ~/.ssh/config.d/common.conf — hosts every hat shares.
#   3. The `Host *` defaults at the bottom of this file.
#
# Both config.d files are machine-local and NOT in the dotfiles repo (hats never
# touches unmanaged files there). ~/.ssh/config.d/README has the recipe.
#
# Variables in Include need OpenSSH 9.9+ (`hats doctor` checks). A process with no
# hat at all (a GUI app, launchd) makes ssh warn that HATS_HAT has no value; it
# skips layer 1 and carries on.
Include ~/.ssh/config.d/${HATS_HAT}.conf
Include ~/.ssh/config.d/common.conf

Host *
  AddKeysToAgent yes
{% if os == "darwin" %}
  UseKeychain yes
{% endif %}
  ServerAliveInterval 30
  ServerAliveCountMax 3
  HashKnownHosts no
  IdentitiesOnly yes
