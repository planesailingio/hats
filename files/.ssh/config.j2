# ~/.ssh/config — shared skeleton. Managed by hats.
#
# Everything client/machine-specific lives in ~/.ssh/config.d/*.conf, which is NOT in
# the dotfiles repo (hats never touches unmanaged files there). See
# ~/.ssh/config.d/README for the per-client recipe — the short version:
#
#   * Client-only hostnames go in ordinary `Host` blocks.
#   * Hostnames shared across clients (github.com…) use `Match host … exec` on
#     $HATS_PROFILE (or its alias $DEV_PROFILE), which hats exports on every
#     profile switch, so the right key is picked per shell with no wrappers:
#     plain ssh, scp, rsync and git all honour it.
#
# Order matters: ssh takes the FIRST value it finds for each option, so the includes
# come before the `Host *` defaults below and the local files can override anything.
Include ~/.ssh/config.d/*.conf

Host *
  AddKeysToAgent yes
{% if os == "darwin" %}
  UseKeychain yes
{% endif %}
  ServerAliveInterval 30
  ServerAliveCountMax 3
  HashKnownHosts no
  IdentitiesOnly yes
